    "/nodes/{node_id}/blast-radius": {
      "get": {
        "summary": "Blast Radius Endpoint",
        "operationId": "blast_radius_endpoint_nodes__node_id__blast_radius_get",
        "parameters": [
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Node Id"
            }
          },
          {
            "name": "max_depth",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 0,
              "default": 3,
              "title": "Max Depth"
            }
          },
          {
            "name": "weighted",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Weighted"
            }
          }
        ],
        "responses": {
