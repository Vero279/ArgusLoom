{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 30,
  "maxItems": 30,
  "items": {
    "type": "object",
    "required": ["question_id", "question", "expected", "source_refs", "scope"],
    "properties": {
      "question_id": { "type": "string" },
      "question": { "type": "string" },
      "expected": { "type": "object", "minProperties": 1 },
      "forged_values": { "type": "object" },
      "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "scope": {
        "enum": ["cve_primary", "path_risk_primary", "technique_secondary", "topology_negative_control"]
      }
    }
  }
}
